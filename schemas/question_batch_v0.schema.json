{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam-intelligence/question-batch-v0",
  "title": "Exam Intelligence Staging Question Batch V0",
  "type": "object",
  "required": ["schema_version", "source", "exam", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 0},
    "source": {"$ref": "#/$defs/source"},
    "exam": {"$ref": "#/$defs/exam"},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "provider", "adapter", "adapter_version"],
      "properties": {
        "source_type": {"type": "string"},
        "provider": {"type": "string"},
        "uri": {"type": ["string", "null"]},
        "adapter": {"type": "string"},
        "adapter_version": {"type": "string"},
        "rights_status": {"type": ["string", "null"]}
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank"],
      "properties": {
        "external_id": {"type": ["string", "null"]},
        "bank": {"type": "string"},
        "organ": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "year": {"type": ["integer", "null"]},
        "exam_date": {"type": ["string", "null"]},
        "form_code": {"type": ["string", "null"]},
        "scoring_policy": {"type": ["string", "null"]}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": {"type": "string"},
        "text": {"type": "string"},
        "position": {"type": ["integer", "null"]}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "type", "stem", "options"],
      "properties": {
        "external_id": {"type": ["string", "null"]},
        "number": {"type": ["string", "integer"]},
        "type": {"enum": ["single_choice", "multi_choice", "true_false", "numeric", "short_answer"]},
        "stem": {"type": "string", "minLength": 1},
        "stimulus": {"type": ["string", "null"]},
        "media_refs": {"type": "array", "items": {"type": "string"}, "default": []},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "answer_key": {"type": ["string", "array", "number", "boolean", "null"]},
        "answer_key_status": {"enum": ["unknown", "provisional", "final", "changed", "annulled"]},
        "subject": {"type": ["string", "null"]},
        "topic_path": {"type": ["string", "null"]},
        "raw_locator": {"type": ["string", "null"]},
        "parser_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "needs_review_reasons": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["single_choice", "multi_choice"]}}}, "then": {"properties": {"options": {"minItems": 2}}}},
        {"if": {"properties": {"type": {"enum": ["numeric", "short_answer"]}}}, "then": {"properties": {"options": {"maxItems": 0}}}}
      ]
    }
  }
}
